
# ─── On-chain billing (Stripe/cards come later) ───────────────────────────────
# Treasury wallet that receives USDC pro-plan payments (REQUIRED for billing)
PAYMENT_RECEIVER_ADDRESS=
# Chain for payments: 8453 Base (default), 84532 Base Sepolia, 1 Ethereum, 11155111 Sepolia
PAYMENT_CHAIN_ID=8453
# Price of the pro plan in USDC
PRO_PRICE_USDC=20
# Optional custom RPC endpoint (defaults to the chain's public RPC)
PAYMENT_RPC_URL=
# Optional USDC contract override (defaults to the canonical USDC per chain)
PAYMENT_USDC_ADDRESS=
