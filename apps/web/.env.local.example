# Financial data API keys — all free tiers.
# Copy this file to `.env.local` and fill in the values you obtain from each provider.
# Routes degrade gracefully: a missing key just returns { data: null, error: "API key missing" }.

# Alpha Vantage — US stocks, fundamentals, FX historic, news, movers
# Sign up: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub — company profile + earnings calendar
# Sign up: https://finnhub.io/register
FINNHUB_API_KEY=

# FRED — macro indicators (GDP, CPI, FEDFUNDS, etc.)
# Sign up: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Open Exchange Rates — forex live rates
# Sign up: https://openexchangerates.org/signup/free
OPEN_EXCHANGE_RATES_APP_ID=

# Twelve Data — non-US stocks + symbol search
# Sign up: https://twelvedata.com/register
TWELVE_DATA_API_KEY=
