{
  "name": "bitprivat-desktop",
  "version": "0.4.0",
  "description": "BitPrivat trading platform — desktop app",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-log": "^5.1.2",
    "electron-store": "^8.2.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.bitprivat.desktop",
    "productName": "BitPrivat",
    "copyright": "Copyright © 2024 BitPrivat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../apps/web/.next",
        "to": "web/.next",
        "filter": ["**/*"]
      },
      {
        "from": "../../apps/web/public",
        "to": "web/public",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.finance"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Finance"
    }
  }
}
