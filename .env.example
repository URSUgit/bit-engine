# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:3000

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production-use-openssl-rand-base64-32

# ─── JWT (shared by API Gateway) ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-64
JWT_EXPIRES_IN=7d

# ─── WalletConnect ────────────────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ─── API Gateway ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8080

# ─── Trading Engine ───────────────────────────────────────────────────────────
TRADING_ENGINE_HOST=0.0.0.0
TRADING_ENGINE_PORT=9090
TRADING_ENGINE_WS_PORT=9091

# ─── Signal Service ───────────────────────────────────────────────────────────
SIGNAL_SERVICE_HOST=0.0.0.0
SIGNAL_SERVICE_PORT=8001
NEXT_PUBLIC_SIGNAL_SERVICE_URL=http://localhost:8001

# ─── TimescaleDB (Postgres) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://bitprivat:bitprivat@localhost:5432/bitprivat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bitprivat
POSTGRES_USER=bitprivat
POSTGRES_PASSWORD=bitprivat

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://bitprivat:bitprivat@localhost:27017/bitprivat
MONGO_DB=bitprivat

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=bitprivat-group

# ─── Exchange APIs ────────────────────────────────────────────────────────────
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_PRIVATE_KEY=

POLYMARKET_API_URL=https://clob.polymarket.com
POLYMARKET_PRIVATE_KEY=

# ─── Social / Scraper ─────────────────────────────────────────────────────────
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=

# ─── AI / Models ──────────────────────────────────────────────────────────────
FINBERT_MODEL_PATH=ProsusAI/finbert
OPENAI_API_KEY=

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
